[41.996074, "o", "\u001b[1mdiff --git a/jobs/load_orders.py b/jobs/load_orders.py\u001b[m\r\n\u001b[1mindex f470539..66d4815 100644\u001b[m\r\n\u001b[1m--- a/jobs/load_orders.py\u001b[m\r\n\u001b[1m+++ b/jobs/load_orders.py\u001b[m\r\n\u001b[36m@@ -1,10 +1,11 @@\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport os\u001b[m\r\n from warehouse import read_csv, write_table\u001b[m\r\n \u001b[m\r\n\u001b[31m-DB_PASSWORD = \"s3cr3t-production-pw\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mDB_PASSWORD = os.environ[\"DB_PASSWORD\"]\u001b[m\r\n"]
[41.996134, "o", " SOURCE = \"s3://acme-prod-landing/orders/\"\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n\u001b[31m-def run_load(day):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef run_load(day, target_environment: str = \"dev\", dry_run: bool = False):\u001b[m\r\n     \"\"\"Copy one day of orders into the warehouse.\"\"\"\u001b[m\r\n     rows = read_csv(f\"{SOURCE}{day}.csv\")\u001b[m\r\n     return write_table(\"orders\", rows, password=DB_PASSWORD)\u001b[m\r\n"]
