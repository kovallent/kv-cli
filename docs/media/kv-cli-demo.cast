[16.391913, "o", "\u001b[1mkv-cli\u001b[0m \u001b[1;36mfix\u001b[0m\r\n\r\n\u001b[4m./jobs/load_orders.py\u001b[0m\r\n  \u001b[1;32m+\u001b[0m added `\u001b[1mtarget_environment\u001b[0m` to run_load()\r\n  \u001b[1;32m+\u001b[0m added `\u001b[1mdry_run\u001b[0m` to run_load()\r\n  \u001b[1;33m~\u001b[0m `\u001b[1mDB_PASSWORD\u001b[0m` now reads os.environ[\u001b[1m\"DB_PASSWORD\"\u001b[0m]\r\n"]
[16.392045, "o", "\r\n\u001b[1;32mFIXED\u001b[0m applied 3 changes across 1 file\r\n\u001b[2mreview the diff, then re-run `kv-cli audit`\u001b[0m\r\n\r\n  \u001b[1;31mrotate:\u001b[0m 1 credential was in source: treat it as exposed - rotate, then set the new value in the environment; removing it from the file does not remove it from git history\r\n  \u001b[1;31mbackups:\u001b[0m still holding the original plaintext - delete after reviewing the diff, and add `*.kvbak` to .gitignore so a backup is never committed:\r\n        ./jobs/load_orders.py.kvbak\r\n"]
